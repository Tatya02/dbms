CREATE TABLE emp_log (
 id INT,
 msg VARCHAR(100)
);

DELIMITER //
CREATE TRIGGER emp_after_insert
AFTER INSERT ON employee
FOR EACH ROW
BEGIN
 INSERT INTO emp_log VALUES(NEW.emp_id,'New Employee Inserted');
END //

DELIMITER ;

INSERT INTO employee VALUES(5,'Pooja',27000,'HR');

